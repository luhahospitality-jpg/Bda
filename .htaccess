# Apache/LiteSpeed (LatinCloud): same behaviour as vercel.json
Options -MultiViews
RewriteEngine On

# Never expose the git checkout or repo files
RedirectMatch 404 /\.git
RedirectMatch 404 /(README\.md|vercel\.json)$

# Always HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Old site pages -> new sections
RewriteRule ^bda-proyectos(\.html)?$ /#proyectos [R=301,NE,L]
RewriteRule ^(alvear-icon-puerto-madero|alvear-tower|casa-anchorena|sls-hotel-suites|sls-lux-residences)-bda-realty(\.html)?$ /#proyectos [R=301,NE,L]
RewriteRule ^bda(\.html)?$ /#equipo [R=301,NE,L]
RewriteRule ^contact(\.html)?$ /#contacto [R=301,NE,L]
RewriteRule ^news(\.html)?$ /newsletter [R=301,L]

# Clean URLs: /plaza.html -> /plaza, and serve /plaza from plaza.html
RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
