{
  "cleanUrls": true,
  "redirects": [
    { "source": "/bda-proyectos(.html)?", "destination": "/#proyectos", "permanent": true },
    { "source": "/bda(.html)?", "destination": "/#equipo", "permanent": true },
    { "source": "/contact(.html)?", "destination": "/#contacto", "permanent": true },
    { "source": "/news(.html)?", "destination": "/newsletter", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
