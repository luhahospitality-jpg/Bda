{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/bda-proyectos(.html)?",
      "destination": "/#proyectos",
      "permanent": true
    },
    {
      "source": "/(alvear-icon-puerto-madero|alvear-tower|casa-anchorena|sls-hotel-suites|sls-lux-residences)-bda-realty(.html)?",
      "destination": "/#proyectos",
      "permanent": true
    },
    {
      "source": "/bda(.html)?",
      "destination": "/#equipo",
      "permanent": true
    },
    {
      "source": "/contact(.html)?",
      "destination": "/#contacto",
      "permanent": true
    },
    {
      "source": "/news(.html)?",
      "destination": "/newsletter",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
