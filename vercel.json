{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.bda-realty.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
